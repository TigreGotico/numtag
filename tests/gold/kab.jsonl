{"text": "Zzenzen mitin alef n yidlisen.", "mentions": [{"start": 8, "end": 18, "value": "200000", "kind": "cardinal"}], "source": "languagesandnumbers.com, \"Counting in Kabyle\": \"alef [1,000], juǧ alaf [2,000], tlat-alaf [3,000]\", \"ɛecrin-alaf [20,000]\", \"mya-alaf [100,000]\"; arithmetic: 200000."}
{"text": "Zzenzen xemsa u ɛecrin alef n yidlisen.", "mentions": [{"start": 8, "end": 27, "value": "25000", "kind": "cardinal"}], "source": "languagesandnumbers.com, \"Counting in Kabyle\": \"alef [1,000], juǧ alaf [2,000], tlat-alaf [3,000]\", \"ɛecrin-alaf [20,000]\", \"mya-alaf [100,000]\"; arithmetic: 25000."}
{"text": "Llan amelyun n yimdanen.", "mentions": [{"start": 5, "end": 12, "value": "1000000", "kind": "cardinal"}], "source": "languagesandnumbers.com, \"Counting in Kabyle\": \"amelyun [1 million]\"."}
{"text": "Ad yeswu amelyar.", "mentions": [{"start": 9, "end": 16, "value": "1000000000", "kind": "cardinal"}], "source": "languagesandnumbers.com, \"Counting in Kabyle\": \"amelyar [1 billion]\"."}
{"text": "Ad yeswu amelyaṛ.", "mentions": [{"start": 9, "end": 16, "value": "1000000000", "kind": "cardinal"}], "source": "fr.wiktionary, Modèle:cardinaux/kab: \"amelyaṛ\"."}
{"text": "Ɣur-s sin imelyunen.", "mentions": [{"start": 6, "end": 19, "value": "2000000", "kind": "cardinal"}], "source": "fr.wiktionary \"amelyun\": million; plural imelyunen; 2 x 10^6."}
{"text": "Ɣur-s tlata imelyunen.", "mentions": [{"start": 6, "end": 21, "value": "3000000", "kind": "cardinal"}], "source": "fr.wiktionary \"amelyun\"; 3 x 10^6."}
{"text": "D amḍan wis sin.", "mentions": [{"start": 8, "end": 15, "value": "2", "kind": "ordinal"}], "source": "en.wiktionary \"wis\" (after Kossmann 2013): wis (feminine tis) and a cardinal is an ordinal; omniglot writes \"wiss\", \"tiss\"; 2."}
{"text": "D amḍan tis snat.", "mentions": [{"start": 8, "end": 16, "value": "2", "kind": "ordinal"}], "source": "en.wiktionary \"wis\" (after Kossmann 2013): wis (feminine tis) and a cardinal is an ordinal; omniglot writes \"wiss\", \"tiss\"; 2."}
{"text": "D amḍan wis tlata.", "mentions": [{"start": 8, "end": 17, "value": "3", "kind": "ordinal"}], "source": "en.wiktionary \"wis\" (after Kossmann 2013): wis (feminine tis) and a cardinal is an ordinal; omniglot writes \"wiss\", \"tiss\"; 3."}
{"text": "D amḍan tis tlata.", "mentions": [{"start": 8, "end": 17, "value": "3", "kind": "ordinal"}], "source": "en.wiktionary \"wis\" (after Kossmann 2013): wis (feminine tis) and a cardinal is an ordinal; omniglot writes \"wiss\", \"tiss\"; 3."}
{"text": "D amḍan wis ṛebɛa.", "mentions": [{"start": 8, "end": 17, "value": "4", "kind": "ordinal"}], "source": "en.wiktionary \"wis\" (after Kossmann 2013): wis (feminine tis) and a cardinal is an ordinal; omniglot writes \"wiss\", \"tiss\"; 4."}
{"text": "D amḍan wis xemsa.", "mentions": [{"start": 8, "end": 17, "value": "5", "kind": "ordinal"}], "source": "en.wiktionary \"wis\" (after Kossmann 2013): wis (feminine tis) and a cardinal is an ordinal; omniglot writes \"wiss\", \"tiss\"; 5."}
{"text": "D amḍan tis xemsa.", "mentions": [{"start": 8, "end": 17, "value": "5", "kind": "ordinal"}], "source": "en.wiktionary \"wis\" (after Kossmann 2013): wis (feminine tis) and a cardinal is an ordinal; omniglot writes \"wiss\", \"tiss\"; 5."}
{"text": "D amḍan wis setta.", "mentions": [{"start": 8, "end": 17, "value": "6", "kind": "ordinal"}], "source": "en.wiktionary \"wis\" (after Kossmann 2013): wis (feminine tis) and a cardinal is an ordinal; omniglot writes \"wiss\", \"tiss\"; 6."}
{"text": "D amḍan wis sebɛa.", "mentions": [{"start": 8, "end": 17, "value": "7", "kind": "ordinal"}], "source": "en.wiktionary \"wis\" (after Kossmann 2013): wis (feminine tis) and a cardinal is an ordinal; omniglot writes \"wiss\", \"tiss\"; 7."}
{"text": "D amḍan wis tmanya.", "mentions": [{"start": 8, "end": 18, "value": "8", "kind": "ordinal"}], "source": "en.wiktionary \"wis\" (after Kossmann 2013): wis (feminine tis) and a cardinal is an ordinal; omniglot writes \"wiss\", \"tiss\"; 8."}
{"text": "D amḍan wis tesɛa.", "mentions": [{"start": 8, "end": 17, "value": "9", "kind": "ordinal"}], "source": "en.wiktionary \"wis\" (after Kossmann 2013): wis (feminine tis) and a cardinal is an ordinal; omniglot writes \"wiss\", \"tiss\"; 9."}
{"text": "D amḍan wis ɛecṛa.", "mentions": [{"start": 8, "end": 17, "value": "10", "kind": "ordinal"}], "source": "en.wiktionary \"wis\" (after Kossmann 2013): wis (feminine tis) and a cardinal is an ordinal; omniglot writes \"wiss\", \"tiss\"; 10."}
{"text": "D amḍan wis ɛecrin.", "mentions": [{"start": 8, "end": 18, "value": "20", "kind": "ordinal"}], "source": "en.wiktionary \"wis\" (after Kossmann 2013): wis (feminine tis) and a cardinal is an ordinal; omniglot writes \"wiss\", \"tiss\"; 20."}
{"text": "D amḍan wiss sin.", "mentions": [{"start": 8, "end": 16, "value": "2", "kind": "ordinal"}], "source": "en.wiktionary \"wis\" (after Kossmann 2013): wis (feminine tis) and a cardinal is an ordinal; omniglot writes \"wiss\", \"tiss\"; 2."}
{"text": "D amḍan tiss snat.", "mentions": [{"start": 8, "end": 17, "value": "2", "kind": "ordinal"}], "source": "en.wiktionary \"wis\" (after Kossmann 2013): wis (feminine tis) and a cardinal is an ordinal; omniglot writes \"wiss\", \"tiss\"; 2."}
{"text": "D amezwaru.", "mentions": [{"start": 2, "end": 10, "value": "1", "kind": "ordinal"}], "source": "en.wiktionary \"amezwaru\": first."}
{"text": "D tamezwarut.", "mentions": [{"start": 2, "end": 12, "value": "1", "kind": "ordinal"}], "source": "en.wiktionary \"amezwaru\": feminine tamezwarut."}
{"text": "D aneggaru.", "mentions": [], "source": "en.wikipedia \"Kabyle grammar\": \"aneggaru\", last, no number."}
{"text": "Amḍan-a d 15.", "mentions": [{"start": 10, "end": 12, "value": "15", "kind": "cardinal"}], "source": "CLDR main/kab.xml: decimal \",\", group a no-break space; the digits read as written."}
{"text": "Amḍan-a d 2025.", "mentions": [{"start": 10, "end": 14, "value": "2025", "kind": "cardinal"}], "source": "CLDR main/kab.xml: decimal \",\", group a no-break space; the digits read as written."}
{"text": "Amḍan-a d 2,5.", "mentions": [{"start": 10, "end": 13, "value": "2.5", "kind": "decimal"}], "source": "CLDR main/kab.xml: decimal \",\", group a no-break space; the digits read as written."}
{"text": "Amḍan-a d 0,75.", "mentions": [{"start": 10, "end": 14, "value": "0.75", "kind": "decimal"}], "source": "CLDR main/kab.xml: decimal \",\", group a no-break space; the digits read as written."}
{"text": "Amḍan-a d 1 000.", "mentions": [{"start": 10, "end": 15, "value": "1000", "kind": "cardinal"}], "source": "CLDR main/kab.xml: decimal \",\", group a no-break space; the digits read as written."}
{"text": "Amḍan-a d 1 000 000.", "mentions": [{"start": 10, "end": 19, "value": "1000000", "kind": "cardinal"}], "source": "CLDR main/kab.xml: decimal \",\", group a no-break space; the digits read as written."}
{"text": "Amḍan-a d 3,14.", "mentions": [{"start": 10, "end": 14, "value": "3.14", "kind": "decimal"}], "source": "CLDR main/kab.xml: decimal \",\", group a no-break space; the digits read as written."}
{"text": "Amḍan-a d 12 500,5.", "mentions": [{"start": 10, "end": 18, "value": "12500.5", "kind": "decimal"}], "source": "CLDR main/kab.xml: decimal \",\", group a no-break space; the digits read as written."}
{"text": "Sɛiɣ sin n warraw d snat n yessi.", "mentions": [{"start": 5, "end": 8, "value": "2", "kind": "cardinal"}, {"start": 20, "end": 24, "value": "2", "kind": "cardinal"}], "source": "arithmetic; two numbers in one sentence."}
{"text": "xemsa neɣ setta", "mentions": [{"start": 0, "end": 5, "value": "5", "kind": "cardinal"}, {"start": 10, "end": 15, "value": "6", "kind": "cardinal"}], "source": "arithmetic; two numbers."}
{"text": "Gar ɛecṛa d ɛecrin.", "mentions": [{"start": 4, "end": 9, "value": "10", "kind": "cardinal"}, {"start": 12, "end": 18, "value": "20", "kind": "cardinal"}], "source": "arithmetic; two numbers."}
{"text": "tlata, ṛebɛa, xemsa.", "mentions": [{"start": 0, "end": 5, "value": "3", "kind": "cardinal"}, {"start": 7, "end": 12, "value": "4", "kind": "cardinal"}, {"start": 14, "end": 19, "value": "5", "kind": "cardinal"}], "source": "arithmetic; the commas split the numbers."}
{"text": "Ur sɛiɣ ara idrimen.", "mentions": [], "source": "no number."}
{"text": "Aqcic-agi meẓẓi.", "mentions": [], "source": "no number."}
{"text": "Yuɣ azgen n weɣrum.", "mentions": [{"start": 4, "end": 9, "value": "0.5", "kind": "fraction"}], "source": "fr.wiktionary \"azgen\": \"Moitié\"."}
{"text": "tesɛa u tesɛin d mya.", "mentions": [{"start": 0, "end": 14, "value": "99", "kind": "cardinal"}, {"start": 17, "end": 20, "value": "100", "kind": "cardinal"}], "source": "arithmetic: 9 + 90; 100."}
{"text": "Sɛiɣ ziṛu.", "mentions": [{"start": 5, "end": 9, "value": "0", "kind": "cardinal"}], "source": "languagesandnumbers.com, \"Counting in Kabyle\": \"ziṛu or ilem\"."}
{"text": "Lliɣ sin n wussan.", "mentions": [{"start": 5, "end": 8, "value": "2", "kind": "cardinal"}], "source": "en.wikipedia \"Kabyle grammar\": sin \"two\"."}
{"text": "Lliɣ snat n tsaɛtin.", "mentions": [{"start": 5, "end": 9, "value": "2", "kind": "cardinal"}], "source": "en.wikipedia \"Kabyle grammar\": snat, feminine \"two\"."}
{"text": "sebɛa wussan deg yimalas.", "mentions": [{"start": 0, "end": 5, "value": "7", "kind": "cardinal"}], "source": "languagesandnumbers.com, \"Counting in Kabyle\": \"sebɛa [7]\"."}
{"text": "tnac n wayyuren deg useggas.", "mentions": [{"start": 0, "end": 4, "value": "12", "kind": "cardinal"}], "source": "languagesandnumbers.com, \"Counting in Kabyle\": \"tnac [12]\"."}
{"text": "ɛecrin n yidinaren", "mentions": [{"start": 0, "end": 6, "value": "20", "kind": "cardinal"}], "source": "languagesandnumbers.com, \"Counting in Kabyle\": \"ɛecrin [20]\"."}
{"text": "mya u xemsin n yidularen", "mentions": [{"start": 0, "end": 12, "value": "150", "kind": "cardinal"}], "source": "languagesandnumbers.com, \"Counting in Kabyle\": mya is 100; \"u\" joins the rest; 100 + 50. No source shows the joiner after mya."}
{"text": "alef u mya n yidularen", "mentions": [{"start": 0, "end": 10, "value": "1100", "kind": "cardinal"}], "source": "languagesandnumbers.com, \"Counting in Kabyle\": alef 1000, mya 100; 1000 + 100. No source shows the joiner after alef."}
{"text": "ɛecrin u mya", "mentions": [{"start": 0, "end": 6, "value": "20", "kind": "cardinal"}, {"start": 9, "end": 12, "value": "100", "kind": "cardinal"}], "source": "a ten before mya is no compound in any source; two numbers."}
{"text": "Rebɛa n wussan.", "mentions": [{"start": 0, "end": 5, "value": "4", "kind": "cardinal"}], "source": "en.wiktionary \"rebɛa\": four."}
{"text": "ɛecra n tsaɛtin.", "mentions": [{"start": 0, "end": 5, "value": "10", "kind": "cardinal"}], "source": "en.wiktionary \"ɛecra\": ten, alternative of ɛecṛa."}
{"text": "rbeɛṭac n yiseggasen.", "mentions": [{"start": 0, "end": 7, "value": "14", "kind": "cardinal"}], "source": "en.wiktionary, Module:number_list/data/kab: \"rbeɛṭac\", 14."}
{"text": "ḥdac n yimdanen.", "mentions": [{"start": 0, "end": 4, "value": "11", "kind": "cardinal"}], "source": "en.wiktionary, Module:number_list/data/kab: \"ḥdac\", 11."}
{"text": "tesɛaṭac n yiseggasen.", "mentions": [{"start": 0, "end": 8, "value": "19", "kind": "cardinal"}], "source": "en.wiktionary, Module:number_list/data/kab: \"tesɛaṭac\", 19."}
{"text": "myat alef n yimdanen.", "mentions": [{"start": 0, "end": 9, "value": "100000", "kind": "cardinal"}], "source": "Tatoeba 9342858 \"temn-myat alef\"; \"mya [100]\" (languagesandnumbers.com); 100 x 1000."}
{"text": "sin d kraḍ", "mentions": [{"start": 0, "end": 3, "value": "2", "kind": "cardinal"}, {"start": 6, "end": 10, "value": "3", "kind": "cardinal"}], "source": "en.wikipedia \"Kabyle grammar\"; en.wiktionary \"kraḍ\"; \"d\" joins no number."}
{"text": "xemsa u ɛecrin d xemsa u tlatin", "mentions": [{"start": 0, "end": 14, "value": "25", "kind": "cardinal"}, {"start": 17, "end": 31, "value": "35", "kind": "cardinal"}], "source": "arithmetic: 5 + 20; 5 + 30."}
{"text": "waḥed u ɛecrin n tsaɛtin", "mentions": [{"start": 0, "end": 14, "value": "21", "kind": "cardinal"}], "source": "languagesandnumbers.com, \"Counting in Kabyle\": \"waḥed u ɛecrin [21]\"."}
{"text": "tmanya u ṛebɛin n tsaɛtin", "mentions": [{"start": 0, "end": 15, "value": "48", "kind": "cardinal"}], "source": "arithmetic: 8 + 40."}
{"text": "tlata u settin n yiseggasen", "mentions": [{"start": 0, "end": 14, "value": "63", "kind": "cardinal"}], "source": "arithmetic: 3 + 60."}
{"text": "xemsa u sebɛin n yiseggasen", "mentions": [{"start": 0, "end": 14, "value": "75", "kind": "cardinal"}], "source": "arithmetic: 5 + 70."}
{"text": "sebɛa u tmanyin n yiseggasen", "mentions": [{"start": 0, "end": 15, "value": "87", "kind": "cardinal"}], "source": "arithmetic: 7 + 80."}
{"text": "tnayn u xemsin n yimdanen", "mentions": [{"start": 0, "end": 14, "value": "52", "kind": "cardinal"}], "source": "arithmetic: 2 + 50."}
{"text": "setta u tesɛin n yimdanen", "mentions": [{"start": 0, "end": 14, "value": "96", "kind": "cardinal"}], "source": "arithmetic: 6 + 90."}
{"text": "ṛebɛa u ɛecrin n tsaɛtin", "mentions": [{"start": 0, "end": 14, "value": "24", "kind": "cardinal"}], "source": "arithmetic: 4 + 20."}
{"text": "tesɛa u ṛebɛin n yidularen", "mentions": [{"start": 0, "end": 14, "value": "49", "kind": "cardinal"}], "source": "arithmetic: 9 + 40."}
{"text": "Tafriqt, tesɛa tamurt n Lezzayer.", "mentions": [{"start": 9, "end": 14, "value": "9", "kind": "cardinal", "low_confidence": true, "reasons": ["homograph"]}], "source": "kab.wikipedia sentence; en.wiktionary \"sɛu\": \"to have , to possess , to own\"; alone tesɛa reads as nine at low confidence."}
{"text": "Ɣur-i tesɛa u ɛecrin n yiseggasen.", "mentions": [{"start": 6, "end": 20, "value": "29", "kind": "cardinal"}], "source": "languagesandnumbers.com: \"tesɛa [9]\", \"ɛecrin [20]\"; 9 + 20 = 29."}
{"text": "Ha-tt-an d ssaɛtin ɣiṛ ṛṛbeɛ.", "mentions": [{"start": 11, "end": 18, "value": "2", "kind": "cardinal"}], "source": "Tatoeba sentence 13763607 \"Ha-tt-an d ssaɛtin ɣiṛ ṛṛbeɛ.\" (\"It's quarter to two.\")"}
{"text": "Ad d-uɣaleɣ ɣef ssetta d wezgen.", "mentions": [{"start": 16, "end": 22, "value": "6", "kind": "cardinal"}], "source": "Tatoeba sentence 11226836 \"Ad d-uɣaleɣ ɣef ssetta d wezgen.\" (\"I will be back at half past six.\")"}
{"text": "Ha-tt-an d leḥḍac u ṛṛbeɛ.", "mentions": [{"start": 11, "end": 17, "value": "11", "kind": "cardinal"}], "source": "Tatoeba sentence 13763625 \"Ha-tt-an d leḥḍac u ṛṛbeɛ.\" (\"It's a quarter past eleven.\")"}
{"text": "Deg yiḍ n wass n lḥedd d letniyen (ɣef ttnac n yiḍ)", "mentions": [{"start": 39, "end": 44, "value": "12", "kind": "cardinal"}], "source": "kab.wikipedia, \"Tafsut n Yimaziɣen\": \"Deg yiḍ n wass n lḥedd d letniyen (ɣef ttnac n yiḍ)\""}
{"text": "ɣef lxemsa u xemsin n ddqayeq, anebdad (préfet) n yibulisen n Paris yenna-as i Useqqamu n uḥuddu n yizerfan idelsanen deg Ldzayer.", "mentions": [{"start": 4, "end": 10, "value": "5", "kind": "cardinal"}, {"start": 13, "end": 19, "value": "50", "kind": "cardinal"}], "source": "kab.wikipedia, \"Tafsut n Yimaziɣen\": \"ɣef lxemsa u xemsin n ddqayeq, anebdad (préfet) n yibulisen n Paris yenna-as i Useqqamu n uḥuddu n yizerfan idelsanen deg Ldzayer\": the hour noun closes the number, and the minutes are a number of their own; languagesandnumbers.com, \"Counting in Kabyle\": \"xemsin [50]\""}
