{"text": "Sɛiɣ xemsa yemcac.", "mentions": [{"start": 5, "end": 10, "value": "5", "kind": "cardinal"}], "source": "languagesandnumbers.com, \"Counting in Kabyle\": \"xemsa [5]\"."}
{"text": "Ttmeslayeɣ tlata tutlayin.", "mentions": [{"start": 11, "end": 16, "value": "3", "kind": "cardinal"}], "source": "Tatoeba 9602352 (I speak three languages)."}
{"text": "Sɛiɣ ɛecrin n yiseggasen.", "mentions": [{"start": 5, "end": 11, "value": "20", "kind": "cardinal"}], "source": "Tatoeba 12725218 (I am twenty years old)."}
{"text": "Lqern, d mya iseggasen.", "mentions": [{"start": 9, "end": 12, "value": "100", "kind": "cardinal"}], "source": "Tatoeba 9779937 (A century is one hundred years)."}
{"text": "Ṣerrfeɣ telt mya n yidularen.", "mentions": [{"start": 8, "end": 16, "value": "300", "kind": "cardinal"}], "source": "Tatoeba 13097021; 3 x 100."}
{"text": "Ḥesbeɣ armi d mitin.", "mentions": [{"start": 14, "end": 19, "value": "200", "kind": "cardinal"}], "source": "Tatoeba 10564198 (I counted to two hundred)."}
{"text": "Serseɣ alef idularen deg tbanka.", "mentions": [{"start": 7, "end": 11, "value": "1000", "kind": "cardinal"}], "source": "Tatoeba 8506369 ($1,000)."}
{"text": "Yeswa tlatin alef n yidulaṛen.", "mentions": [{"start": 6, "end": 17, "value": "30000", "kind": "cardinal"}], "source": "Tatoeba 12429007 \"tlatin alef n yidulaṛen\"; 30 x 1000."}
{"text": "Yezzenz axxam-is s xemsin alef idularen.", "mentions": [{"start": 19, "end": 30, "value": "50000", "kind": "cardinal"}], "source": "Tatoeba 8919355; 50 x 1000."}
{"text": "Tatoeba yewweḍ temn-myat alef n tefyar.", "mentions": [{"start": 15, "end": 29, "value": "800000", "kind": "cardinal"}], "source": "Tatoeba 9342858; 8 x 100 x 1000."}
{"text": "Yuklal arraz wis tlata.", "mentions": [{"start": 13, "end": 22, "value": "3", "kind": "ordinal"}], "source": "Tatoeba 12632704 (third prize); wis + cardinal."}
{"text": "Yesɛa amahil wis sin.", "mentions": [{"start": 13, "end": 20, "value": "2", "kind": "ordinal"}], "source": "Tatoeba 12804902 (second job); wis + cardinal."}
{"text": "D azgen.", "mentions": [{"start": 2, "end": 7, "value": "0.5", "kind": "fraction"}], "source": "Tatoeba 11117577 (It is a half); fr.wiktionary \"azgen\": \"Moitié\"."}
{"text": "Ad d-awiɣ ilem.", "mentions": [{"start": 10, "end": 14, "value": "0", "kind": "cardinal"}], "source": "languagesandnumbers.com, \"Counting in Kabyle\": \"ilem\" is 0."}
{"text": "Ad d-awiɣ ziṛu.", "mentions": [{"start": 10, "end": 14, "value": "0", "kind": "cardinal"}], "source": "languagesandnumbers.com, \"Counting in Kabyle\": \"ziṛu\" is 0."}
