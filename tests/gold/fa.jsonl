{"text": "دو و سه می‌شود پنج.", "mentions": [{"start": 0, "end": 2, "value": "2", "kind": "cardinal"}, {"start": 5, "end": 7, "value": "3", "kind": "cardinal"}, {"start": 15, "end": 18, "value": "5", "kind": "cardinal"}], "source": "arithmetic; \"و\" between two units makes no number."}
{"text": "پول ندارم.", "mentions": [], "source": "no number."}
{"text": "علی بلند است.", "mentions": [], "source": "no number."}
{"text": "دویست تومان و سی ریال.", "mentions": [{"start": 0, "end": 5, "value": "200", "kind": "cardinal"}, {"start": 14, "end": 16, "value": "30", "kind": "cardinal"}], "source": "arithmetic."}
{"text": "سه کیلومتر دور است.", "mentions": [{"start": 0, "end": 2, "value": "3", "kind": "cardinal"}], "source": "CLDR RBNF fa."}
{"text": "چهل و هشت ساعت گذشت.", "mentions": [{"start": 0, "end": 9, "value": "48", "kind": "cardinal"}], "source": "arithmetic: 40 + 8."}
{"text": "هفتاد از صد.", "mentions": [{"start": 0, "end": 5, "value": "70", "kind": "cardinal"}, {"start": 9, "end": 11, "value": "100", "kind": "cardinal"}], "source": "arithmetic."}
{"text": "صد و دو کتاب.", "mentions": [{"start": 0, "end": 7, "value": "102", "kind": "cardinal"}], "source": "arithmetic: 100 + 2."}
{"text": "سه میلیون و پانصد هزار تومان.", "mentions": [{"start": 0, "end": 22, "value": "3500000", "kind": "cardinal"}], "source": "arithmetic: 3 x 10^6 + 500 x 1000."}
{"text": "يک و دو.", "mentions": [{"start": 0, "end": 2, "value": "1", "kind": "cardinal"}, {"start": 5, "end": 7, "value": "2", "kind": "cardinal"}], "source": "Arabic yeh in \"يک\" reads as Persian ی."}
{"text": "دوازده ماه.", "mentions": [{"start": 0, "end": 6, "value": "12", "kind": "cardinal"}], "source": "CLDR RBNF fa: \"12: دوازده\"."}
{"text": "شصت دقیقه.", "mentions": [{"start": 0, "end": 3, "value": "60", "kind": "cardinal"}], "source": "CLDR RBNF fa: \"60: شصت\"."}
{"text": "نود ثانیه.", "mentions": [{"start": 0, "end": 3, "value": "90", "kind": "cardinal"}], "source": "CLDR RBNF fa: \"90: نود\"."}
{"text": "هشتصد و هشتاد کیلومتر.", "mentions": [{"start": 0, "end": 13, "value": "880", "kind": "cardinal"}], "source": "arithmetic: 800 + 80."}
{"text": "چهار هزار نفر.", "mentions": [{"start": 0, "end": 9, "value": "4000", "kind": "cardinal"}], "source": "arithmetic: 4 x 1000."}
{"text": "هفت هزار و هفتصد تومان.", "mentions": [{"start": 0, "end": 16, "value": "7700", "kind": "cardinal"}], "source": "arithmetic: 7 x 1000 + 700."}
{"text": "پنجاه هزار تماشاگر.", "mentions": [{"start": 0, "end": 10, "value": "50000", "kind": "cardinal"}], "source": "arithmetic: 50 x 1000."}
{"text": "دویست هزار نفر.", "mentions": [{"start": 0, "end": 10, "value": "200000", "kind": "cardinal"}], "source": "arithmetic: 200 x 1000."}
{"text": "دو میلیارد دلار.", "mentions": [{"start": 0, "end": 10, "value": "2000000000", "kind": "cardinal"}], "source": "arithmetic: 2 x 10^9."}
{"text": "دوازده ممیز پنج درصد.", "mentions": [{"start": 0, "end": 15, "value": "12.5", "kind": "decimal"}], "source": "CLDR RBNF fa: \"x.x: << ممیز >>\"; 12 + 0.5."}
{"text": "منفی سی درجه.", "mentions": [{"start": 0, "end": 7, "value": "-30", "kind": "cardinal"}], "source": "CLDR RBNF fa: \"-x: منفی >>\"."}
{"text": "چهارده و پانزده.", "mentions": [{"start": 0, "end": 6, "value": "14", "kind": "cardinal"}, {"start": 9, "end": 15, "value": "15", "kind": "cardinal"}], "source": "arithmetic."}
{"text": "بیست و دو بهمن.", "mentions": [{"start": 0, "end": 9, "value": "22", "kind": "cardinal"}], "source": "arithmetic: 20 + 2."}
{"text": "هفده شهریور.", "mentions": [{"start": 0, "end": 4, "value": "17", "kind": "cardinal"}], "source": "CLDR RBNF fa: \"17: هفده\"."}
{"text": "سیصد و شصت و پنج روز.", "mentions": [{"start": 0, "end": 16, "value": "365", "kind": "cardinal"}], "source": "arithmetic: 300 + 60 + 5."}
{"text": "بیست و چهار ساعت.", "mentions": [{"start": 0, "end": 11, "value": "24", "kind": "cardinal"}], "source": "arithmetic: 20 + 4."}
{"text": "هزار و یک شب.", "mentions": [{"start": 0, "end": 9, "value": "1001", "kind": "cardinal"}], "source": "arithmetic: 1000 + 1."}
{"text": "یک روز خوب.", "mentions": [{"start": 0, "end": 2, "value": "1", "kind": "cardinal", "low_confidence": true}], "source": "\"یک\" before a noun also marks it indefinite."}
{"text": "شش ماه.", "mentions": [{"start": 0, "end": 2, "value": "6", "kind": "cardinal"}], "source": "CLDR RBNF fa: \"6: شش\"."}
{"text": "ششصد تومان.", "mentions": [{"start": 0, "end": 4, "value": "600", "kind": "cardinal"}], "source": "CLDR RBNF fa: \"600: ششصد\"."}
