{"text": "كلف ١٥ دينارا.", "mentions": [{"start": 4, "end": 6, "value": "15", "kind": "cardinal"}], "source": "CLDR arab digits."}
{"text": "دفعت 1,234.5 دولار.", "mentions": [{"start": 5, "end": 12, "value": "1234.5", "kind": "decimal"}], "source": "CLDR main/ar latn: group \",\", decimal \".\"."}
{"text": "كلف 15 دولارا.", "mentions": [{"start": 4, "end": 6, "value": "15", "kind": "cardinal"}], "source": "digits."}
{"text": "الحرارة ‎-5 درجات.", "mentions": [{"start": 9, "end": 11, "value": "-5", "kind": "cardinal"}], "source": "CLDR main/ar writes the minus as \"‎-\"; the directional mark is no part of the number."}
{"text": "ربح ٣ ملايين دولار.", "mentions": [{"start": 4, "end": 12, "value": "3000000", "kind": "cardinal"}], "source": "arithmetic: 3 x 10^6."}
{"text": "جاء اثنان وذهب ثلاثة.", "mentions": [{"start": 4, "end": 9, "value": "2", "kind": "cardinal"}, {"start": 15, "end": 20, "value": "3", "kind": "cardinal"}], "source": "arithmetic."}
{"text": "عندي خمس تفاحات وسبع برتقالات.", "mentions": [{"start": 5, "end": 8, "value": "5", "kind": "cardinal"}, {"start": 16, "end": 20, "value": "7", "kind": "cardinal"}], "source": "arithmetic; the joined و starts the word, so the span covers it."}
{"text": "بين عشرة وعشرين شخصا.", "mentions": [{"start": 4, "end": 8, "value": "10", "kind": "cardinal"}, {"start": 9, "end": 15, "value": "20", "kind": "cardinal"}], "source": "arithmetic; \"بين\" opens a range and the joined و starts the second limit."}
{"text": "عشرون، ثلاثون وأربعون.", "mentions": [{"start": 0, "end": 5, "value": "20", "kind": "cardinal"}, {"start": 7, "end": 13, "value": "30", "kind": "cardinal"}, {"start": 14, "end": 21, "value": "40", "kind": "cardinal"}], "source": "arithmetic; the comma splits the numbers."}
{"text": "طلب خمسة عشر وأخذ اثني عشر.", "mentions": [{"start": 4, "end": 12, "value": "15", "kind": "cardinal"}, {"start": 18, "end": 26, "value": "12", "kind": "cardinal"}], "source": "arithmetic."}
{"text": "بين ألف وألفين دينار.", "mentions": [{"start": 4, "end": 7, "value": "1000", "kind": "cardinal"}, {"start": 8, "end": 14, "value": "2000", "kind": "cardinal"}], "source": "arithmetic; \"بين\" opens a range."}
{"text": "في الفريق أحد عشر لاعبا وخمسة احتياط.", "mentions": [{"start": 10, "end": 17, "value": "11", "kind": "cardinal"}, {"start": 24, "end": 29, "value": "5", "kind": "cardinal"}], "source": "arithmetic."}
{"text": "لست أدري.", "mentions": [], "source": "\"لست\" is \"I am not\"; a preposition comes off only before three letters."}
{"text": "لا أملك مالا.", "mentions": [], "source": "no number."}
{"text": "محمد طويل.", "mentions": [], "source": "no number."}
{"text": "معه مائتا دينار وثلاثون قرشا.", "mentions": [{"start": 4, "end": 9, "value": "200", "kind": "cardinal"}, {"start": 16, "end": 23, "value": "30", "kind": "cardinal"}], "source": "arithmetic."}
{"text": "يبعد ثلاثة كيلومترات.", "mentions": [{"start": 5, "end": 10, "value": "3", "kind": "cardinal"}], "source": "CLDR RBNF ar."}
{"text": "مرت ثمان وأربعون ساعة.", "mentions": [{"start": 4, "end": 16, "value": "48", "kind": "cardinal"}], "source": "Ryding: \"ثمان\" is the feminine 8; 8 + 40."}
{"text": "حصل على سبعين من مائة.", "mentions": [{"start": 8, "end": 13, "value": "70", "kind": "cardinal"}, {"start": 17, "end": 21, "value": "100", "kind": "cardinal"}], "source": "arithmetic."}
{"text": "فقدت مائة واثنان كتاب.", "mentions": [{"start": 5, "end": 16, "value": "102", "kind": "cardinal"}], "source": "arithmetic: 100 + 2."}
{"text": "كلف ثلاثة ملايين وخمسمائة ألف دينار.", "mentions": [{"start": 4, "end": 29, "value": "3500000", "kind": "cardinal"}], "source": "arithmetic: 3 x 10^6 + 500 x 1000."}
{"text": "ثَلَاثَةُ أَوْلَادٍ.", "mentions": [{"start": 0, "end": 9, "value": "3", "kind": "cardinal"}], "source": "the harakat do not change the word."}
{"text": "خَمْسَةٌ وَعِشْرُونَ طَالِبًا.", "mentions": [{"start": 0, "end": 20, "value": "25", "kind": "cardinal"}], "source": "the harakat do not change the words; 5 + 20."}
{"text": "ثلاثه اولاد.", "mentions": [{"start": 0, "end": 5, "value": "3", "kind": "cardinal"}], "source": "final ه for ة reads the same."}
{"text": "بخمسة دولارات.", "mentions": [{"start": 0, "end": 5, "value": "5", "kind": "cardinal"}], "source": "ب is a joined preposition."}
{"text": "للعشرة الأوائل.", "mentions": [{"start": 0, "end": 6, "value": "10", "kind": "cardinal"}], "source": "لل (li + al-) is a joined preposition and article."}
{"text": "الخمسة الكبار.", "mentions": [{"start": 0, "end": 6, "value": "5", "kind": "cardinal"}], "source": "the joined article al-."}
{"text": "سبعة عشر درجة.", "mentions": [{"start": 0, "end": 8, "value": "17", "kind": "cardinal"}], "source": "arithmetic: 7 + 10."}
{"text": "تسعون ثانية.", "mentions": [{"start": 0, "end": 5, "value": "90", "kind": "cardinal"}], "source": "CLDR RBNF ar: \"90: تسعون\"."}
{"text": "ثمانمائة وثمانون كيلومترا.", "mentions": [{"start": 0, "end": 16, "value": "880", "kind": "cardinal"}], "source": "arithmetic: 800 + 80."}
{"text": "أربعة آلاف شخص.", "mentions": [{"start": 0, "end": 10, "value": "4000", "kind": "cardinal"}], "source": "arithmetic: 4 x 1000."}
{"text": "سبعة آلاف وسبعمائة دينار.", "mentions": [{"start": 0, "end": 18, "value": "7700", "kind": "cardinal"}], "source": "arithmetic: 7 x 1000 + 700."}
{"text": "خمسون ألفا متفرج.", "mentions": [{"start": 0, "end": 10, "value": "50000", "kind": "cardinal"}], "source": "CLDR RBNF ar: \"11000: << ألف\"; 50 x 1000."}
{"text": "اثنا عشر فاصلة خمسة بالمائة.", "mentions": [{"start": 0, "end": 19, "value": "12.5", "kind": "decimal"}, {"start": 20, "end": 27, "value": "100", "kind": "cardinal"}], "source": "CLDR RBNF ar: \"x.x: << فاصل >>\"; 12 + 0.5; \"بالمائة\" is \"per hundred\"."}
{"text": "ناقص ثلاثين درجة.", "mentions": [{"start": 0, "end": 11, "value": "-30", "kind": "cardinal"}], "source": "CLDR RBNF ar: \"-x: ناقص >>\"."}
{"text": "ستون دقيقة.", "mentions": [{"start": 0, "end": 4, "value": "60", "kind": "cardinal"}], "source": "CLDR RBNF ar: \"60: ستون\"."}
{"text": "ثلاثمائة وخمسة وستون يوما.", "mentions": [{"start": 0, "end": 20, "value": "365", "kind": "cardinal"}], "source": "arithmetic: 300 + 5 + 60."}
{"text": "أربع وعشرون ساعة.", "mentions": [{"start": 0, "end": 11, "value": "24", "kind": "cardinal"}], "source": "arithmetic: 4 + 20."}
{"text": "في الكتاب مائة وأحد عشر صفحة.", "mentions": [{"start": 10, "end": 23, "value": "111", "kind": "cardinal"}], "source": "CLDR RBNF ar: \"100: مائة[ و>>]\", \"11: أحد عشر\"; 100 + 11 = 111."}
{"text": "تأسست المدينة قبل ألف وإحدى عشرة سنة.", "mentions": [{"start": 18, "end": 32, "value": "1011", "kind": "cardinal"}], "source": "CLDR RBNF ar: \"1000: ألف[ و>>]\", feminine \"11: إحدى عشرة\"; 1000 + 11 = 1011."}
